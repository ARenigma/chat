{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "index.js",
    "App.tsx",
    "__tests__/**/*.{ts,tsx}",
    "scripts/**/*.{mjs,js}"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "admin/**",
    "web/**",
    "supabase/**",
    "src/lib/database.types.ts",
    "src/theme/*.generated.ts",
    "src/lib/*.generated.ts"
  ],
  "ignoreDependencies": [
    "@react-native/.*",
    "@babel/.*",
    "react-native-.*",
    "@commitlint/.*"
  ],
  "ignoreBinaries": ["uvx"]
}
