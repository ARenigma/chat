{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": ["App.tsx", "__tests__/**/*.{ts,tsx}", "scripts/**/*.{mjs,js}"],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "admin/**",
    "web/**",
    "supabase/**",
    "src/lib/database.types.ts",
    "src/theme/*.generated.ts",
    "src/lib/*.generated.ts"
  ],
  "ignoreDependencies": [
    "@babel/.*",
    "react-native-.*",
    "@emoji-mart/data",
    "@phosphor-icons/core",
    "@env"
  ],
  "ignoreBinaries": [
    "uvx",
    "maestro",
    "psql",
    "adb",
    "sips",
    "supabase",
    "sentry-cli"
  ]
}
