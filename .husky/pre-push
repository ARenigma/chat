# Nothing reaches a remote without deterministic checks, changed-code security,
# and a completed finding-free Greptile review for the exact commit being pushed.
remote="${1:-origin}"
head_sha="$(git rev-parse HEAD)"
zero_sha="0000000000000000000000000000000000000000"
pushed=0

# Git supplies one line per ref: <local-ref> <local-sha> <remote-ref> <remote-sha>.
# The working tree can only verify its checked-out commit. Fail closed if a
# caller tries `git push origin other-branch`; they must check that branch out so
# tests, SAST, and Greptile all inspect the bytes actually being published.
while read -r local_ref local_sha remote_ref remote_sha; do
  # Deleting a remote ref has an all-zero local SHA and publishes no code.
  if [ "$local_sha" = "$zero_sha" ]; then
    continue
  fi
  pushed=1
  # Annotated tags supply the tag-object SHA, not its target commit. Peel every
  # object to a commit before comparison so a release tag pointing at reviewed
  # HEAD is allowed while a tag/branch pointing elsewhere is still refused.
  peeled_sha="$(git rev-parse "${local_sha}^{commit}" 2>/dev/null || true)"
  if [ -z "$peeled_sha" ] || [ "$peeled_sha" != "$head_sha" ]; then
    echo "pre-push: refusing unverified ref $local_ref ($local_sha)." >&2
    echo "Check out that ref and push again; current HEAD is $head_sha." >&2
    exit 1
  fi
done

if [ "$pushed" -eq 0 ]; then
  exit 0
fi

npm run verify
SECURITY_BASE_REF="${remote}/main" npm run security:push
bash scripts/greptile-review.sh status "$head_sha"
