{
  "name": "companionchat",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest",
    "test:db": "node scripts/db-test.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify": "npm run tokens:check && npm run typecheck && npm run lint && npm test && npm run verify:manifest && npm run bundle:android",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "android:clean": "cd android && ./gradlew clean",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output /tmp/companionchat.android.bundle --sourcemap-output /tmp/companionchat.android.bundle.map",
    "prepare": "husky",
    "verify:hermes": "node scripts/verify-hermes.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:install": "node scripts/e2e.mjs --install",
    "verify:full": "npm run verify && npm run test:db",
    "tokens": "node scripts/gen-tokens.mjs",
    "tokens:check": "node scripts/gen-tokens.mjs --check",
    "distribute": "node scripts/distribute.mjs",
    "ship": "npm run android:release && npm run verify:manifest && npm run verify:hermes && npm run distribute"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@sentry/react-native": "^8.23.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "^4.5.3",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "^0.11.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^17.3.0",
    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.12",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
