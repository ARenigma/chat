{
  "name": "companionchat",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-2.0",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android --active-arch-only",
    "android:dev": "bash scripts/dev-device.sh",
    "ios": "react-native run-ios",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "jest",
    "control": "node scripts/control-pappal.mjs",
    "security:staged": "bash scripts/security-check.sh staged",
    "security:push": "bash scripts/security-check.sh push",
    "security:sast": "bash scripts/security-check.sh sast",
    "security:dependencies": "bash scripts/security-check.sh dependencies",
    "security:ci": "bash scripts/security-check.sh ci",
    "deadcode": "knip --no-progress --max-issues 0",
    "python:check": "uvx ruff@0.15.22 check scripts && uvx vulture@2.16 scripts --min-confidence 60",
    "review:greptile": "bash scripts/greptile-review.sh review",
    "review:greptile:status": "bash scripts/greptile-review.sh status",
    "test:db": "node scripts/db-test.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "verify:source": "npm run tokens:check && npm run tokens:web:check && npm run icons:check && npm run icons:font:check && npm run handles:check && npm run emoji:check && npm run contact-guard:check && npm run contrast:check && npm run web:check && npm run design:check && npm run typecheck && npm run lint",
    "verify:artifact": "npm run verify:manifest && npm run bundle:android && npm run size:check",
    "verify": "npm run verify:source && npm test && npm run verify:artifact",
    "verify:ci": "npm run verify:source && npm test -- --ci --coverage --coverageReporters=text-summary --coverageReporters=cobertura && npm run verify:artifact",
    "size:check": "node scripts/size-gate.mjs",
    "android:release": "cd android && ./gradlew assembleRelease -PreactNativeArchitectures=arm64-v8a,armeabi-v7a --no-configuration-cache",
    "android:bundle": "cd android && ./gradlew bundleRelease -PreactNativeArchitectures=arm64-v8a,armeabi-v7a --no-configuration-cache",
    "android:bundle:closed": "cd android && ./gradlew bundleClosedTest -PreactNativeArchitectures=arm64-v8a,armeabi-v7a --no-configuration-cache",
    "android:lint": "cd android && ./gradlew :app:lintDebug -x :react-native-worklets:lintAnalyzeDebug -x :react-native-reanimated:lintAnalyzeDebug",
    "android:baseline-profile": "cd android && ./gradlew :app:generateBaselineProfile --no-parallel",
    "android:benchmark:startup": "cd android && ./gradlew :baselineprofile:connectedNonMinifiedInternalAndroidTest -Pandroid.testInstrumentationRunnerArguments.class=com.companionchat.baselineprofile.StartupBenchmark -Pandroid.testInstrumentationRunnerArguments.androidx.benchmark.enabledRules=Macrobenchmark -Pandroid.testInstrumentationRunnerArguments.androidx.benchmark.suppressErrors=EMULATOR -PreactNativeArchitectures=arm64-v8a --no-parallel",
    "android:benchmark:feel": "node scripts/run-feel-benchmark.mjs",
    "android:benchmark:feel:collect": "cd android && ./gradlew :baselineprofile:connectedNonMinifiedInternalAndroidTest -Pandroid.testInstrumentationRunnerArguments.class=com.companionchat.baselineprofile.FeelBenchmark -Pandroid.testInstrumentationRunnerArguments.androidx.benchmark.enabledRules=Macrobenchmark -PreactNativeArchitectures=arm64-v8a --no-parallel",
    "android:framestats": "node scripts/framestats.mjs",
    "android:v2-device-gates": "node scripts/v2-device-gates.mjs",
    "android:perfetto": "bash scripts/perfetto-feel.sh",
    "android:benchmark:gate": "node scripts/benchmark-gate.mjs",
    "android:lab": "bash scripts/check-android-lab.sh",
    "android:qa": "bash scripts/qa-device.sh",
    "android:clean": "cd android && ./gradlew clean",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output /tmp/companionchat.android.bundle --sourcemap-output /tmp/companionchat.android.bundle.map",
    "prepare": "husky",
    "verify:hermes": "node scripts/verify-hermes.mjs",
    "e2e": "node scripts/e2e.mjs",
    "e2e:install": "node scripts/e2e.mjs --install",
    "call-sim": "node scripts/call-sim.mjs",
    "call-sim:report": "node scripts/call-sim-report.mjs",
    "verify:full": "npm run verify && npm run test:db",
    "tokens": "node scripts/gen-tokens.mjs",
    "tokens:check": "node scripts/gen-tokens.mjs --check",
    "ship": "npm run android:bundle && npm run verify:manifest && npm run verify:hermes",
    "moderate": "node scripts/moderate.mjs",
    "review": "node scripts/review-console.mjs",
    "provider": "node scripts/provider-console.mjs",
    "tokens:web": "node scripts/gen-web-tokens.mjs",
    "tokens:web:check": "node scripts/gen-web-tokens.mjs --check",
    "icons": "node scripts/gen-icons.mjs",
    "icons:check": "node scripts/gen-icons.mjs --check",
    "handles": "node scripts/gen-handles.mjs",
    "handles:check": "node scripts/gen-handles.mjs --check",
    "emoji": "node scripts/gen-emoji.mjs",
    "emoji:check": "node scripts/gen-emoji.mjs --check",
    "contact-guard": "node scripts/gen-contact-guard.mjs",
    "contact-guard:check": "node scripts/gen-contact-guard.mjs --check",
    "design:check": "impeccable detect web/",
    "contrast:check": "node scripts/check-contrast.mjs",
    "web:check": "node scripts/check-web.mjs",
    "android:internal": "cd android && ./gradlew assembleInternal",
    "version:bump": "node scripts/version-bump.mjs",
    "icons:font": "node scripts/gen-icons-font.mjs",
    "icons:font:check": "node scripts/gen-icons-font.mjs --check",
    "sentry:maps": "node scripts/sentry-maps.mjs"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-firebase/app": "^26.3.1",
    "@react-native-firebase/auth": "^26.3.1",
    "@react-native-firebase/messaging": "^26.3.1",
    "@react-navigation/bottom-tabs": "7.19.2",
    "@react-navigation/native": "7.4.1",
    "@react-navigation/native-stack": "7.19.2",
    "@sentry/react-native": "^8.26.0",
    "@shopify/flash-list": "^2.3.2",
    "@supabase/supabase-js": "^2.112.3",
    "@tanstack/react-query": "^5.101.4",
    "js-sha256": "^1.0.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-agora": "^4.6.4",
    "cashfree-pg-api-contract": "2.1.1",
    "react-native-cashfree-pg-sdk": "^2.4.0",
    "react-native-gesture-handler": "^3.2.1",
    "react-native-get-random-values": "^2.0.0",
    "react-native-image-picker": "^7.2.3",
    "react-native-keyboard-controller": "^1.22.5",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-nitro-sound": "^0.2.19",
    "react-native-pager-view": "6.8.0",
    "react-native-reanimated": "^4.6.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "4.28.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-video": "6.19.3",
    "react-native-worklets": "^0.12.1",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "brace-expansion@1": "1.1.21",
    "brace-expansion@5": "5.0.12",
    "@grpc/grpc-js": "^1.13.6",
    "shell-quote": "^1.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@emoji-mart/data": "1.2.1",
    "@phosphor-icons/core": "2.1.1",
    "@react-native-community/cli": "20.1.2",
    "@react-native-community/cli-platform-android": "20.1.2",
    "@react-native-community/cli-platform-ios": "20.1.2",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/jest": "^29.5.13",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "eslint": "^8.19.0",
    "fantasticon": "^4.1.0",
    "husky": "^9.1.7",
    "impeccable": "^3.6.0",
    "jest": "^29.6.3",
    "knip": "^6.38.0",
    "lint-staged": "^17.3.0",
    "prettier": "2.8.8",
    "react-native-dotenv": "^3.4.12",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.12.0"
  }
}
