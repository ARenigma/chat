# Stage 4 lanes. Deliberately thin: the build already happened in ci.yml, so
# these lanes only ever move an artefact that has passed every gate. Nothing here
# compiles anything, which keeps "what was tested" and "what was shipped"
# identical by construction.

default_platform(:android)

PRODUCTION_AAB = "../android/app/build/outputs/bundle/release/app-release.aab"
CLOSED_TEST_AAB = "../android/app/build/outputs/bundle/closedTest/app-closedTest.aab"

platform :android do
  # Store listing text (and, opt-in, images) with no build attached. Reads the
  # scaffold in fastlane/metadata/android/<locale>/ — copy generated images into
  # metadata/.../images/ first (see that folder's README) and pass images:true.
  # Needs a Play service account JSON at $PLAY_SERVICE_ACCOUNT_JSON_PATH (Appfile),
  # invited to the Play Console with "Edit store listing" permission.
  desc "Push store listing metadata (and optionally images); no AAB"
  lane :metadata do |options|
    with_images = options[:images] == true || options[:images] == "true"
    upload_to_play_store(
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: false,
      skip_upload_changelogs: false,
      skip_upload_images: !with_images,
      skip_upload_screenshots: !with_images,
      validate_only: options[:validate_only] == true || options[:validate_only] == "true",
    )
  end

  desc "Upload the gated AAB to internal testing"
  lane :internal do
    upload_to_play_store(
      track: "internal",
      aab: CLOSED_TEST_AAB,
      release_status: "completed",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      validate_only: false,
    )
  end

  # ---------------------------------------------------------------------------
  # Closed testing
  # ---------------------------------------------------------------------------
  # There was no lane for this, and the nearest-looking one was a trap: `beta`
  # targets Play's `beta` track, which is OPEN testing — anyone with the opt-in
  # link. Reaching for it to do "closed testing" publishes far wider than
  # intended.
  #
  # Closed testing has NO reserved track id. Google: "Closed testing tracks are
  # created manually and they have custom names."
  # https://developers.google.com/android-publisher/tracks
  #
  # So the track name is REQUIRED and never defaulted. A guess here would either
  # fail loudly (fine) or silently create a new track (not fine) — and the one
  # value worth guessing, `alpha`, is only right for apps whose closed track
  # happens to still carry that legacy name.
  #
  #   bundle exec fastlane android closed track:"<name from Play Console>"
  #
  # `release_status: "draft"` on purpose: it uploads and stops, so the artefact
  # can be seen in the Console before a single tester gets it. Pass
  # status:"completed" to hand it straight to the cohort.
  desc "Upload the gated AAB to a named CLOSED testing track"
  lane :closed do |options|
    track = options[:track]
    UI.user_error!(
      "Pass the closed-testing track name, e.g. track:\"beta-cohort\". Play does " \
      "not reserve an id for closed testing — the name is whatever it was " \
      "created as in the Console. See " \
      "https://developers.google.com/android-publisher/tracks",
    ) if track.nil? || track.to_s.strip.empty?

    upload_to_play_store(
      track: track.to_s,
      aab: CLOSED_TEST_AAB,
      release_status: options[:status] || "draft",
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  # NOTE the track: `beta` is Play's OPEN testing track, not a closed one — see
  # the `closed` lane above. The name of this lane is historical; what it does is
  # a staged OPEN rollout.
  desc "Staged rollout on the OPEN testing track"
  lane :beta do |options|
    fraction = (options[:rollout] || "0.1").to_f
    upload_to_play_store(
      track: "beta",
      aab: CLOSED_TEST_AAB,
      release_status: "inProgress",
      rollout: fraction.to_s,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Widen an in-progress rollout"
  lane :widen do |options|
    upload_to_play_store(
      track: options[:track] || "beta",
      rollout: (options[:rollout] || "0.5").to_s,
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
  end

  desc "Stop a rollout dead. Called when release health drops below threshold."
  lane :halt_rollout do |options|
    track = options[:track] || "beta"
    # Halting is a rollout of 0: existing installs keep the build, nobody new
    # receives it. Deliberately not a version rollback — Play cannot un-ship a
    # version code, so the recovery path is halt, then ship a fix forward.
    upload_to_play_store(
      track: track,
      rollout: "0",
      skip_upload_aab: true,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
    )
    UI.important("Rollout on #{track} halted at 0%. Ship a fix forward; Play cannot un-publish a version code.")
  end
end
