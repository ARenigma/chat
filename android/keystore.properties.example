# Copy to `android/keystore.properties` (git-ignored) on the release machine.
# Generate the upload key once:
#   keytool -genkeypair -v -storetype PKCS12 -keystore upload.keystore \
#     -alias upload -keyalg RSA -keysize 2048 -validity 10000
# MYAPP_UPLOAD_STORE_FILE is resolved relative to android/app/, so the default
# below means android/app/upload.keystore. Never commit the keystore itself.
MYAPP_UPLOAD_STORE_FILE=upload.keystore
MYAPP_UPLOAD_STORE_PASSWORD=
MYAPP_UPLOAD_KEY_ALIAS=upload
MYAPP_UPLOAD_KEY_PASSWORD=
