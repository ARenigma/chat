<?xml version="1.0" encoding="utf-8"?>
<!-- Prevents session data from migrating to a new device via D2D transfer.
     (developer.android.com/about/versions/12/behavior-changes-12#backup-restrictions) -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
    </device-transfer>
</data-extraction-rules>
