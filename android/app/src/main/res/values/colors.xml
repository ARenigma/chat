<?xml version="1.0" encoding="utf-8"?>
<!--
  Native-side colours. Two of them, and both are the same values as
  design/tokens.json, they cannot be generated from it because they are read by
  the platform before any JavaScript exists.

  ic_launcher_background is bg/inverse (Light): ink, not black. It is the icon's
  whole background, and it is deliberately the same ink as the primary button so
  the launcher and the first screen agree.

  notification_accent is bg/accent (Light): ramp step 500, the logo coral. It
  tints the small icon and the app name in the notification shade, which is the
  one place the brand has to be recognisable before a single word is read.
  2026-09-26: C0492F -> C04018 when every coral role was pinned to one ramp;
  __tests__/contract.test.ts pins it to the token so the two cannot drift.
-->
<resources>
    <color name="ic_launcher_background">#1C1C1E</color>
    <color name="notification_accent">#C04018</color>
</resources>
