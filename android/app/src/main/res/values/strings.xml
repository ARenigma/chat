<resources>
    <!--
      The launcher label, and the only place the product's name reaches a user on
      the device. Renamed from CompanionChat on 2026-08-23, and from Papal to Pappal on
      2026-08-26.

      Deliberately NOT accompanied by an applicationId change: the package stays
      `com.companionchat`. It is the identity Play, Firebase, the upload keystore
      and the `companionchat://` OAuth redirect are all keyed to, and renaming it
      means a new Play listing, a new Firebase app and a broken sign-in redirect.
      A user never sees an applicationId.
    -->
    <string name="app_name">Pappal</string>

    <!--
      The notification channel a user sees in Settings. Named for what it
      carries, not for the app: "Pappal notifications" tells somebody nothing
      about what they would be silencing.
    -->
    <string name="channel_conversations">Messages</string>
    <string name="channel_conversations_desc">Someone you are talking to has replied</string>
    <!--
      The in-app channel (Conversations.CHANNEL_IN_APP): a banner with no sound
      for a chat you are not looking at while the app is open. Its own entry, and
      named for when it fires, so somebody who finds the banner too much can turn
      it off without losing Messages.
    -->
    <string name="channel_conversations_in_app">Messages while using the app</string>
    <string name="channel_conversations_in_app_desc">A quiet banner for a chat you are not looking at</string>
    <!--
      Channel name update (C12, 2026-10-09). The channel is write-once for
      importance and sound, but name and description may be updated via a
      subsequent createNotificationChannel call with the same id.
      https://developer.android.com/develop/ui/views/notifications/channels
      The previous name ("Suggestions") and description ("Nudges when someone
      new is around to talk") were member-facing only and made no sense for a
      provider receiving "member opened your chat" alerts on this same channel.
    -->
    <string name="channel_engagement">Activity</string>
    <string name="channel_engagement_desc">Alerts about activity on your conversations and profile</string>
    <string name="channel_calls">Incoming calls</string>
    <string name="channel_calls_desc">Rings when someone calls you</string>
    <string name="channel_call_ongoing">Call in progress</string>
    <string name="channel_call_ongoing_desc">A quiet, persistent notice while you are on a call</string>

    <!-- MessagingStyle needs a name for the device owner to attribute outgoing
         lines to. It is never displayed for a one-to-one thread, but a null here
         makes the style refuse to build. -->
    <string name="you">You</string>

    <!--
      Truecaller OAuth SDK 3.3.0 client ID.
      Bound to package com.companionchat and the signing SHA-1 registered in the
      Truecaller developer portal at https://sdk-console-noneu.truecaller.com.
      Error 12 ("Invalid partner info") is a hard config failure — it means the
      SHA-1 or package name does not match. Add debug, upload, and Play App
      Signing SHA-1s as separate credentials in the portal.
      https://docs.truecaller.com/truecaller-sdk/android/latest-oauth-sdk-3.3.0/integration-steps/setup
    -->
    <string name="clientID">eq9oguwehbperyo1mnhyyleonpsz8wnbptonnth-rk0</string>

    <!-- The incoming call notification's content line. CallStyle.forIncomingCall
         "will have a default content text for an incoming call"
         (developer.android.com/reference/androidx/core/app/NotificationCompat.CallStyle),
         and that default never says whether the camera is about to come on. -->
    <string name="call_incoming_video">Incoming video call</string>
    <string name="call_incoming_voice">Incoming voice call</string>
    <!-- The heads-up ring's actions, when CallStyle is not allowed (B-BS-8). -->
    <string name="call_action_decline">Decline</string>
    <string name="call_action_answer">Answer</string>

    <!-- CallStyle throws on a Person with an empty name, so the service needs a
         placeholder for a call notification built before the name arrives. -->
    <string name="call_unknown_caller">Caller</string>
</resources>
