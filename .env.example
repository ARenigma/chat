# Copy to `.env`. All three values are client-public by design:
# the anon key is RLS-scoped and the Sentry DSN is an ingest-only endpoint.
# Server-only secrets (SUPABASE_SERVICE_ROLE_KEY, OPENAI_API_KEY) live exclusively
# in Supabase Edge Function secrets and must never appear in this file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SENTRY_DSN=
APP_ENV=development

# MSG91 OTP widget, client pair. MSG91 panel -> OTP widget -> the widget's
# configuration page shows both. Client-public on purpose: they ship in the APK
# and MSG91 issues them for that. The *server* authkey is a different value and
# belongs only in `supabase secrets`, never here.
#
# Leave both blank and phone verification hides itself rather than failing: see
# `widgetConfigured()` in src/lib/msg91Widget.ts.
MSG91_WIDGET_ID=
MSG91_WIDGET_TOKEN=

# TURN relay for symmetric-NAT video calls. Leave all three blank for STUN-only
# (fine for development; most devices behind ordinary NATs connect on reflexive
# candidates without a relay). The TURN entry is only added to ICE_SERVERS when
# TURN_URL is non-empty, so a missing value does not break the build or tests.
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# The Supabase auth SMS hook's shared secret, in the CLI's required format:
#   v1,whsec_<base64>   (minimum 32 characters)
#
# NOT optional, and not only for people who touch SMS. `supabase/config.toml`
# declares `[auth.hook.send_sms] secrets = "env(SEND_SMS_HOOK_SECRET)"`, and the
# CLI validates that expression while PARSING config for any command that loads
# it — including `supabase functions deploy`. With this unset the parse fails
# with "Invalid hook config: auth.hook.send_sms.secrets must be formatted as ...",
# and NO Edge Function can be deployed by anyone, whatever they were changing
# (hit 2026-09-04 deploying cashfree-onboarding-start).
#
# The live value is in the Supabase dashboard under Authentication → Hooks.
SEND_SMS_HOOK_SECRET=
